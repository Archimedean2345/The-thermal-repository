   "source": [
    "import numpy as np\n",
    "\n",
    "E = 210e9\n",
    "A = 1e-4\n",
    "L = 1.0\n",
    "\n",
    "K = E*A/L * np.array([\n",
    "    [1, -1],\n",
    "    [-1, 1]\n",
    "])\n",
    "\n",
    "F = np.array([0,1000])\n",
    "u = np.linalg.solve(\n",
    "    K[1:,1:],\n",
    "    F[1:]\n",
    ")\n",
    "\n",
    "print(u)"
   ]
  }
 ],
